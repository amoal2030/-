rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasValidUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Must be an active user in the organization (blocks disabled employees from read & write)
    function isOrgMember(targetOrgId) {
      return hasValidUserDoc() &&
        getUserData().isActive == true &&
        getUserData().orgId == targetOrgId;
    }

    // Must be an active manager in the organization
    function isOrgManager(targetOrgId) {
      return hasValidUserDoc() &&
        getUserData().isActive == true &&
        getUserData().orgId == targetOrgId &&
        getUserData().role == 'manager';
    }

    function isValidCurrencyAmount(val) {
      return val is number &&
        !math.isNaN(val) &&
        val < 1.0e308 && val > -1.0e308 &&
        math.abs(val * 100 - math.round(val * 100)) < 0.001;
    }

    function hasValidHalalaShiftAccounting(data) {
      return isValidCurrencyAmount(data.cashSales) && data.cashSales >= 0 &&
        isValidCurrencyAmount(data.cardSales) && data.cardSales >= 0 &&
        isValidCurrencyAmount(data.expenses) && data.expenses >= 0 &&
        isValidCurrencyAmount(data.totalSales) && data.totalSales >= 0 &&
        isValidCurrencyAmount(data.remainingInBox) &&
        isValidCurrencyAmount(data.netPeriod) &&
        math.round(data.totalSales * 100) == math.round(data.cashSales * 100) + math.round(data.cardSales * 100) &&
        math.round(data.remainingInBox * 100) == math.round(data.cashSales * 100) - math.round(data.expenses * 100) &&
        math.round(data.netPeriod * 100) == (math.round(data.cashSales * 100) + math.round(data.cardSales * 100)) - math.round(data.expenses * 100);
    }

    function isValidYearMonth(ym) {
      return ym is string && ym.matches('^\\d{4}-(0[1-9]|1[0-2])$');
    }

    function isValidDriveId(val) {
      return val is string &&
        val.size() >= 1 &&
        val.size() <= 256 &&
        val.matches('^[a-zA-Z0-9._\\-]+$') &&
        !val.matches('.*\\.\\..*');
    }

    function isValidIsoTimestamp(ts) {
      return ts is string &&
        ts.size() >= 20 &&
        ts.size() <= 40 &&
        ts.matches('^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?(Z|[+-]\\d{2}:\\d{2})$');
    }

    function closingMatchesYearMonth(c, ym) {
      return c.date is string &&
        c.date.size() == 10 &&
        c.date.matches('^' + ym + '-(0[1-9]|[12]\\d|3[01])$');
    }

    function hasNoDriveProofFields(data) {
      return !('driveExcelFileId' in data) &&
        !('driveExcelFileName' in data) &&
        !('driveExcelWebViewLink' in data) &&
        !('driveMonthFolderId' in data) &&
        !('drivePayloadHash' in data) &&
        !('driveRevision' in data) &&
        !('previousDriveExcelFileId' in data) &&
        !('sourceCorrectionAt' in data) &&
        !('archivedAt' in data) &&
        !('archivedBy' in data);
    }

    function isValidNonApprovedEmployeeClosingData(c, targetOrgId, targetBranchId, ym) {
      return c.orgId == targetOrgId &&
        c.branchId == targetBranchId &&
        c.employeeId == request.auth.uid &&
        c.status in ['draft', 'pending_review', 'rejected'] &&
        closingMatchesYearMonth(c, ym);
    }

    function isExistingClosingNonApprovedForEmployee(closingId, targetOrgId, targetBranchId, ym) {
      let c = get(/databases/$(database)/documents/closings/$(closingId)).data;
      return isValidNonApprovedEmployeeClosingData(c, targetOrgId, targetBranchId, ym);
    }

    function isAfterClosingNonApprovedForEmployee(closingId, targetOrgId, targetBranchId, ym) {
      let cAfter = getAfter(/databases/$(database)/documents/closings/$(closingId)).data;
      return isValidNonApprovedEmployeeClosingData(cAfter, targetOrgId, targetBranchId, ym);
    }

    function hasValidOptionalArchiveFields(data) {
      return (!('driveExcelFileId' in data) || isValidDriveId(data.driveExcelFileId)) &&
        (!('driveExcelFileName' in data) || (data.driveExcelFileName is string && data.driveExcelFileName.trim().size() >= 5 && data.driveExcelFileName.size() <= 256 && data.driveExcelFileName.matches('^[^/\\\\]+\\.[xX][lL][sS][xX]$'))) &&
        (!('driveMonthFolderId' in data) || isValidDriveId(data.driveMonthFolderId)) &&
        (!('driveExcelWebViewLink' in data) || (data.driveExcelWebViewLink is string && data.driveExcelWebViewLink.size() >= 12 && data.driveExcelWebViewLink.size() <= 512 && data.driveExcelWebViewLink.matches('^https://[a-zA-Z0-9.\\-]+/.*$'))) &&
        (!('drivePayloadHash' in data) || (data.drivePayloadHash is string && data.drivePayloadHash.size() == 64 && data.drivePayloadHash.matches('^[a-fA-F0-9]{64}$'))) &&
        (!('driveRevision' in data) || (data.driveRevision is int && data.driveRevision >= 1 && data.driveRevision <= 100000)) &&
        (!('previousDriveExcelFileId' in data) || isValidDriveId(data.previousDriveExcelFileId)) &&
        (!('sourceCorrectionAt' in data) || isValidIsoTimestamp(data.sourceCorrectionAt)) &&
        (!('archivedAt' in data) || isValidIsoTimestamp(data.archivedAt)) &&
        (!('archivedBy' in data) || isValidId(data.archivedBy)) &&
        (!('archiveError' in data) || (data.archiveError is string && data.archiveError.trim().size() >= 5 && data.archiveError.size() <= 1000));
    }

    function hasValidArchivedDriveProof(data, cAfter) {
      return data.keys().hasAll([
          'driveExcelFileId',
          'driveExcelFileName',
          'driveMonthFolderId',
          'drivePayloadHash',
          'driveRevision',
          'archivedAt',
          'archivedBy'
        ]) &&
        isValidDriveId(data.driveExcelFileId) &&
        data.driveExcelFileName is string &&
        data.driveExcelFileName.trim().size() >= 5 &&
        data.driveExcelFileName.size() <= 256 &&
        data.driveExcelFileName.matches('^[^/\\\\]+\\.[xX][lL][sS][xX]$') &&
        isValidDriveId(data.driveMonthFolderId) &&
        data.drivePayloadHash is string &&
        data.drivePayloadHash.size() == 64 &&
        data.drivePayloadHash.matches('^[a-fA-F0-9]{64}$') &&
        data.driveRevision is int &&
        data.driveRevision >= 1 &&
        data.driveRevision <= 100000 &&
        isValidIsoTimestamp(data.archivedAt) &&
        isValidId(data.archivedBy) &&
        data.archivedBy == request.auth.uid &&
        (!('driveExcelWebViewLink' in data) || (data.driveExcelWebViewLink is string && data.driveExcelWebViewLink.size() >= 12 && data.driveExcelWebViewLink.size() <= 512 && data.driveExcelWebViewLink.matches('^https://[a-zA-Z0-9.\\-]+/.*$'))) &&
        (!('previousDriveExcelFileId' in data) || isValidDriveId(data.previousDriveExcelFileId)) &&
        (
          (!('correctedAt' in cAfter) && !('sourceCorrectionAt' in data)) ||
          ('correctedAt' in cAfter && 'sourceCorrectionAt' in data && data.sourceCorrectionAt == cAfter.correctedAt)
        ) &&
        !('archiveError' in data);
    }

    // Preserves ONLY the old archived Drive file proof (strictly separated from sourceCorrectionAt)
    function preservesPreviousArchiveProof(nextData, prevData) {
      return prevData.keys().hasAll([
          'driveExcelFileId',
          'driveExcelFileName',
          'driveMonthFolderId',
          'drivePayloadHash',
          'driveRevision',
          'archivedAt',
          'archivedBy'
        ]) &&
        nextData.driveExcelFileId == prevData.driveExcelFileId &&
        nextData.driveExcelFileName == prevData.driveExcelFileName &&
        nextData.driveMonthFolderId == prevData.driveMonthFolderId &&
        nextData.drivePayloadHash == prevData.drivePayloadHash &&
        nextData.driveRevision == prevData.driveRevision &&
        nextData.archivedAt == prevData.archivedAt &&
        nextData.archivedBy == prevData.archivedBy &&
        (
          (!('driveExcelWebViewLink' in prevData) && !('driveExcelWebViewLink' in nextData)) ||
          ('driveExcelWebViewLink' in prevData && 'driveExcelWebViewLink' in nextData && nextData.driveExcelWebViewLink == prevData.driveExcelWebViewLink)
        ) &&
        (
          (!('previousDriveExcelFileId' in prevData) && !('previousDriveExcelFileId' in nextData)) ||
          ('previousDriveExcelFileId' in prevData && 'previousDriveExcelFileId' in nextData && nextData.previousDriveExcelFileId == prevData.previousDriveExcelFileId)
        );
    }

    // Preserves sourceCorrectionAt matching the active correction in the parent closing
    function preservesCurrentCorrectionRef(nextData, prevData, cAfter) {
      return 'sourceCorrectionAt' in prevData &&
        'sourceCorrectionAt' in nextData &&
        isValidIsoTimestamp(nextData.sourceCorrectionAt) &&
        nextData.sourceCorrectionAt == prevData.sourceCorrectionAt &&
        'correctedAt' in cAfter &&
        nextData.sourceCorrectionAt == cAfter.correctedAt;
    }

    function matchesFreshAdminCorrection(closingId, nextData, prevData, cAfter) {
      let cBefore = get(/databases/$(database)/documents/closings/$(closingId)).data;
      return cBefore.status == 'approved' &&
        cAfter.status == 'approved' &&
        'correctedBy' in cAfter &&
        cAfter.correctedBy == request.auth.uid &&
        'correctedAt' in cAfter &&
        isValidIsoTimestamp(cAfter.correctedAt) &&
        cAfter.correctedAt != cBefore.get('correctedAt', '') &&
        cAfter.correctedAt != prevData.get('sourceCorrectionAt', '') &&
        'sourceCorrectionAt' in nextData &&
        nextData.sourceCorrectionAt == cAfter.correctedAt;
    }

    function isFreshAdminCorrectionForStale(closingId, nextData, prevData, cAfter) {
      return exists(/databases/$(database)/documents/closings/$(closingId)) &&
        matchesFreshAdminCorrection(closingId, nextData, prevData, cAfter);
    }

    function hasRequiredReArchiveProgression(nextData, prevData, cAfter) {
      return 'driveRevision' in prevData && prevData.driveRevision is int &&
        'drivePayloadHash' in prevData &&
        'driveExcelFileId' in prevData &&
        nextData.driveRevision >= prevData.driveRevision + 1 &&
        nextData.drivePayloadHash != prevData.drivePayloadHash &&
        nextData.driveExcelFileId != prevData.driveExcelFileId &&
        'previousDriveExcelFileId' in nextData &&
        nextData.previousDriveExcelFileId == prevData.driveExcelFileId &&
        preservesCurrentCorrectionRef(nextData, prevData, cAfter);
    }

    function hasStatusRequiredFieldsOnCreate(data, cAfter) {
      return (
          data.archiveStatus == 'pending_drive_sync' &&
          cAfter.status in ['draft', 'pending_review', 'rejected', 'approved'] &&
          hasNoDriveProofFields(data) &&
          !('archiveError' in data)
        ) ||
        (
          data.archiveStatus == 'failed' &&
          cAfter.status == 'approved' &&
          hasNoDriveProofFields(data) &&
          'archiveError' in data &&
          data.archiveError is string &&
          data.archiveError.trim().size() >= 5
        ) ||
        (
          data.archiveStatus == 'archived' &&
          cAfter.status == 'approved' &&
          !('previousDriveExcelFileId' in data) &&
          hasValidArchivedDriveProof(data, cAfter)
        );
    }

    function isValidManagerTransition(closingId, nextData, prevData, cAfter) {
      return (
        // 1. pending_drive_sync -> pending_drive_sync
        (
          prevData.archiveStatus == 'pending_drive_sync' &&
          nextData.archiveStatus == 'pending_drive_sync' &&
          cAfter.status in ['draft', 'pending_review', 'rejected', 'approved'] &&
          hasNoDriveProofFields(prevData) &&
          hasNoDriveProofFields(nextData) &&
          !('archiveError' in nextData)
        ) ||
        // 2. pending_drive_sync -> failed
        (
          prevData.archiveStatus == 'pending_drive_sync' &&
          nextData.archiveStatus == 'failed' &&
          cAfter.status == 'approved' &&
          hasNoDriveProofFields(prevData) &&
          hasNoDriveProofFields(nextData) &&
          'archiveError' in nextData
        ) ||
        // 3. pending_drive_sync -> archived
        (
          prevData.archiveStatus == 'pending_drive_sync' &&
          nextData.archiveStatus == 'archived' &&
          cAfter.status == 'approved' &&
          hasNoDriveProofFields(prevData) &&
          !('previousDriveExcelFileId' in nextData) &&
          hasValidArchivedDriveProof(nextData, cAfter)
        ) ||
        // 4. failed -> pending_drive_sync (never archived before)
        (
          prevData.archiveStatus == 'failed' &&
          nextData.archiveStatus == 'pending_drive_sync' &&
          cAfter.status == 'approved' &&
          hasNoDriveProofFields(prevData) &&
          hasNoDriveProofFields(nextData) &&
          !('archiveError' in nextData)
        ) ||
        // 5. failed -> failed (preserves prior proof & sourceCorrectionAt if previously archived)
        (
          prevData.archiveStatus == 'failed' &&
          nextData.archiveStatus == 'failed' &&
          cAfter.status == 'approved' &&
          'archiveError' in nextData &&
          (
            (hasNoDriveProofFields(prevData) && hasNoDriveProofFields(nextData)) ||
            (
              'driveExcelFileId' in prevData &&
              preservesPreviousArchiveProof(nextData, prevData) &&
              preservesCurrentCorrectionRef(nextData, prevData, cAfter)
            )
          )
        ) ||
        // 6. failed -> archived (first archive OR re-archive preserving prior ref & sourceCorrectionAt)
        (
          prevData.archiveStatus == 'failed' &&
          nextData.archiveStatus == 'archived' &&
          cAfter.status == 'approved' &&
          hasValidArchivedDriveProof(nextData, cAfter) &&
          (
            (hasNoDriveProofFields(prevData) && !('previousDriveExcelFileId' in nextData)) ||
            ('driveExcelFileId' in prevData && hasRequiredReArchiveProgression(nextData, prevData, cAfter))
          )
        ) ||
        // 7 & 9 & 11. archived / stale / failed(with prior proof) -> stale (ONLY on fresh atomic correction)
        (
          (
            prevData.archiveStatus in ['archived', 'stale'] ||
            (prevData.archiveStatus == 'failed' && 'driveExcelFileId' in prevData)
          ) &&
          nextData.archiveStatus == 'stale' &&
          !('archiveError' in nextData) &&
          preservesPreviousArchiveProof(nextData, prevData) &&
          isFreshAdminCorrectionForStale(closingId, nextData, prevData, cAfter)
        ) ||
        // 10. stale -> failed (preserves old file proof AND current sourceCorrectionAt)
        (
          prevData.archiveStatus == 'stale' &&
          nextData.archiveStatus == 'failed' &&
          cAfter.status == 'approved' &&
          'archiveError' in nextData &&
          preservesPreviousArchiveProof(nextData, prevData) &&
          preservesCurrentCorrectionRef(nextData, prevData, cAfter)
        ) ||
        // 12. stale -> archived (higher revision, new hash & file ID, preserves prev file ref, matches sourceCorrectionAt)
        (
          prevData.archiveStatus == 'stale' &&
          nextData.archiveStatus == 'archived' &&
          cAfter.status == 'approved' &&
          hasValidArchivedDriveProof(nextData, cAfter) &&
          hasRequiredReArchiveProgression(nextData, prevData, cAfter)
        )
      );
    }

    function managerArchiveCreateMatchesClosing(closingId, data) {
      let cAfter = getAfter(/databases/$(database)/documents/closings/$(closingId)).data;
      return cAfter.orgId == data.orgId &&
        cAfter.branchId == data.branchId &&
        closingMatchesYearMonth(cAfter, data.yearMonth) &&
        hasStatusRequiredFieldsOnCreate(data, cAfter);
    }

    function managerArchiveUpdateMatchesClosing(closingId, nextData, prevData) {
      let cAfter = getAfter(/databases/$(database)/documents/closings/$(closingId)).data;
      return cAfter.orgId == prevData.orgId &&
        cAfter.branchId == prevData.branchId &&
        closingMatchesYearMonth(cAfter, prevData.yearMonth) &&
        isValidManagerTransition(closingId, nextData, prevData, cAfter);
    }

    function canReadClosingArchive(data) {
      let userData = getUserData();
      return userData.isActive == true &&
        userData.orgId == data.orgId && (
          userData.role == 'manager' ||
          (
            userData.role == 'employee' &&
            userData.get('branchId', '') is string &&
            userData.get('branchId', '').size() > 0 &&
            data.branchId == userData.get('branchId', '')
          )
        );
    }

    function canCreateClosingArchive(closingId, data) {
      let userData = getUserData();
      return userData.isActive == true &&
        userData.orgId == data.orgId && (
          (
            userData.role == 'manager' &&
            data.keys().hasOnly([
              'closingId', 'orgId', 'branchId', 'yearMonth', 'archiveStatus',
              'driveExcelFileId', 'driveExcelFileName', 'driveExcelWebViewLink',
              'driveMonthFolderId', 'drivePayloadHash', 'driveRevision',
              'previousDriveExcelFileId', 'sourceCorrectionAt',
              'archivedAt', 'archivedBy', 'archiveError', 'updatedAt'
            ]) &&
            data.archiveStatus in ['pending_drive_sync', 'archived', 'failed'] &&
            hasValidOptionalArchiveFields(data) &&
            existsAfter(/databases/$(database)/documents/closings/$(closingId)) &&
            managerArchiveCreateMatchesClosing(closingId, data)
          ) ||
          (
            userData.role == 'employee' &&
            userData.get('branchId', '') is string &&
            userData.get('branchId', '').size() > 0 &&
            userData.get('branchId', '') == data.branchId &&
            data.keys().hasOnly([
              'closingId', 'orgId', 'branchId', 'yearMonth', 'archiveStatus', 'updatedAt'
            ]) &&
            data.archiveStatus == 'pending_drive_sync' &&
            (
              !exists(/databases/$(database)/documents/closings/$(closingId)) ||
              isExistingClosingNonApprovedForEmployee(closingId, data.orgId, data.branchId, data.yearMonth)
            ) &&
            existsAfter(/databases/$(database)/documents/closings/$(closingId)) &&
            isAfterClosingNonApprovedForEmployee(closingId, data.orgId, data.branchId, data.yearMonth)
          )
        );
    }

    function canUpdateClosingArchive(closingId, nextData, prevData) {
      let userData = getUserData();
      return userData.isActive == true &&
        userData.orgId == prevData.orgId && (
          (
            userData.role == 'manager' &&
            nextData.diff(prevData).affectedKeys().hasOnly([
              'archiveStatus',
              'driveExcelFileId', 'driveExcelFileName', 'driveExcelWebViewLink',
              'driveMonthFolderId', 'drivePayloadHash', 'driveRevision',
              'previousDriveExcelFileId', 'sourceCorrectionAt',
              'archivedAt', 'archivedBy', 'archiveError', 'updatedAt'
            ]) &&
            nextData.archiveStatus in ['pending_drive_sync', 'archived', 'failed', 'stale'] &&
            hasValidOptionalArchiveFields(nextData) &&
            existsAfter(/databases/$(database)/documents/closings/$(closingId)) &&
            managerArchiveUpdateMatchesClosing(closingId, nextData, prevData)
          ) ||
          (
            userData.role == 'employee' &&
            prevData.branchId is string && prevData.branchId.size() > 0 &&
            userData.get('branchId', '') == prevData.branchId &&
            nextData.diff(prevData).affectedKeys().hasOnly(['archiveStatus', 'updatedAt']) &&
            prevData.archiveStatus == 'pending_drive_sync' &&
            nextData.archiveStatus == 'pending_drive_sync' &&
            exists(/databases/$(database)/documents/closings/$(closingId)) &&
            isExistingClosingNonApprovedForEmployee(closingId, prevData.orgId, prevData.branchId, prevData.yearMonth) &&
            existsAfter(/databases/$(database)/documents/closings/$(closingId)) &&
            isAfterClosingNonApprovedForEmployee(closingId, prevData.orgId, prevData.branchId, prevData.yearMonth)
          )
        );
    }

    // Organizations Collection
    match /organizations/{orgId} {
      allow get: if isSignedIn() && isValidId(orgId) && (
        isOrgMember(orgId) ||
        resource.data.ownerId == request.auth.uid
      );

      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(orgId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 120 &&
        incoming().currency in ['SAR', 'AED', 'QAR', 'KWD', 'USD'];

      allow update: if isSignedIn() && isValidId(orgId) &&
        isOrgManager(orgId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id;

      allow delete: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId ||
        (hasValidUserDoc() && isOrgManager(existing().orgId))
      );

      allow list: if isSignedIn() && hasValidUserDoc() && (
        isOrgManager(resource.data.orgId) ||
        resource.data.uid == request.auth.uid
      );

      // Self registration during initial onboarding (as manager of their new org) OR active manager provisioning an employee
      allow create: if isSignedIn() && isValidId(userId) && (
        (
          request.auth.uid == userId &&
          incoming().uid == request.auth.uid &&
          incoming().role == 'manager' &&
          existsAfter(/databases/$(database)/documents/organizations/$(incoming().orgId)) &&
          getAfter(/databases/$(database)/documents/organizations/$(incoming().orgId)).data.ownerId == request.auth.uid
        ) ||
        (hasValidUserDoc() && isOrgManager(incoming().orgId) && incoming().role == 'employee')
      );

      // Prevent role, orgId, branchId, and isActive tampering
      allow update: if isSignedIn() && isValidId(userId) && (
        // Case 1: Employee self-updating display name or phone only (CANNOT change role, orgId, branchId, or isActive)
        (
          request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().orgId == existing().orgId &&
          incoming().branchId == existing().branchId &&
          incoming().isActive == existing().isActive
        ) ||
        // Case 2: Manager updating employee's branch, permissions, or isActive status
        (
          hasValidUserDoc() &&
          isOrgManager(existing().orgId) &&
          incoming().orgId == existing().orgId
        )
      );

      allow delete: if false;
    }

    // Branches Collection
    match /branches/{branchId} {
      allow get: if isSignedIn() && isValidId(branchId) && isOrgMember(resource.data.orgId);
      allow list: if isSignedIn() && hasValidUserDoc() && resource.data.orgId == getUserData().orgId;

      allow create: if isSignedIn() && isValidId(branchId) && (
        (hasValidUserDoc() && isOrgManager(incoming().orgId)) ||
        (
          existsAfter(/databases/$(database)/documents/organizations/$(incoming().orgId)) &&
          getAfter(/databases/$(database)/documents/organizations/$(incoming().orgId)).data.ownerId == request.auth.uid
        )
      );

      allow update: if isSignedIn() && isValidId(branchId) &&
        isOrgManager(existing().orgId) &&
        incoming().orgId == existing().orgId;

      allow delete: if false;
    }

    // Shift Closings Collection
    match /closings/{closingId} {
      allow get: if isSignedIn() && isValidId(closingId) && isOrgMember(resource.data.orgId);
      allow list: if isSignedIn() && hasValidUserDoc() && resource.data.orgId == getUserData().orgId;

      allow create: if isSignedIn() && isValidId(closingId) &&
        isOrgMember(incoming().orgId) &&
        incoming().employeeId == request.auth.uid &&
        incoming().period in ['morning', 'evening'] &&
        incoming().cashSales >= 0 &&
        incoming().cardSales >= 0 &&
        incoming().expenses >= 0 &&
        incoming().status in ['draft', 'pending_review'];

      // Closings Update Rules:
      // Case 1: Non-approved closings (Review by manager OR draft update by employee)
      // Case 2: Free Spark Administrative Correction on approved closings (ACTIVE MANAGER ONLY with strict mathematical and audit checks)
      allow update: if isSignedIn() && isValidId(closingId) && isOrgMember(existing().orgId) && (
        // Scenario A: Non-approved closings
        (
          existing().status != 'approved' && (
            // Manager approving or rejecting a pending closing
            (
              isOrgManager(existing().orgId) &&
              incoming().orgId == existing().orgId &&
              incoming().branchId == existing().branchId &&
              incoming().employeeId == existing().employeeId &&
              incoming().date == existing().date &&
              incoming().period == existing().period &&
              incoming().createdAt == existing().createdAt &&
              incoming().status in ['approved', 'rejected']
            ) ||
            // Employee updating their draft or resubmitting rejected closing
            (
              existing().employeeId == request.auth.uid &&
              incoming().employeeId == existing().employeeId &&
              incoming().orgId == existing().orgId &&
              incoming().branchId == existing().branchId &&
              incoming().date == existing().date &&
              incoming().period == existing().period &&
              incoming().createdAt == existing().createdAt &&
              incoming().status in ['draft', 'pending_review']
            )
          )
        ) ||
        // Scenario B: Documented Administrative Correction on Approved Closing (ACTIVE MANAGER ONLY)
        (
          existing().status == 'approved' &&
          incoming().status == 'approved' &&
          isOrgManager(existing().orgId) &&
          // Historical fields are strictly IMMUTABLE:
          incoming().orgId == existing().orgId &&
          incoming().branchId == existing().branchId &&
          incoming().employeeId == existing().employeeId &&
          incoming().date == existing().date &&
          incoming().period == existing().period &&
          incoming().createdAt == existing().createdAt &&
          // Actor authentication check
          incoming().correctedBy == request.auth.uid &&
          // Mandatory reason (at least 5 characters)
          incoming().correctionReason is string && incoming().correctionReason.size() >= 5 &&
          // Previous values map MUST match genuine previous values on server
          incoming().previousValues is map &&
          incoming().previousValues.cashSales == existing().cashSales &&
          incoming().previousValues.cardSales == existing().cardSales &&
          incoming().previousValues.expenses == existing().expenses &&
          incoming().previousValues.totalSales == existing().totalSales &&
          // Strict Mathematical Accounting verification in Integer Halalas (avoids 0.1 + 0.2 float drift):
          hasValidHalalaShiftAccounting(incoming())
        )
      );

      allow delete: if false;
    }

    // Attachments Collection (Least Privilege: Employee reads ONLY their own uploads)
    match /attachments/{attachmentId} {
      allow get: if isSignedIn() && isValidId(attachmentId) && (
        isOrgManager(resource.data.orgId) ||
        (
          isOrgMember(resource.data.orgId) &&
          resource.data.uploadedBy == request.auth.uid
        )
      );

      allow list: if isSignedIn() && hasValidUserDoc() && (
        isOrgManager(resource.data.orgId) ||
        (
          isOrgMember(resource.data.orgId) &&
          resource.data.uploadedBy == request.auth.uid
        )
      );

      allow create: if isSignedIn() && isValidId(attachmentId) &&
        isOrgMember(incoming().orgId) &&
        incoming().uploadedBy == request.auth.uid &&
        incoming().orgId == getUserData().orgId &&
        // Employee can only upload for their own assigned branch
        (getUserData().role == 'manager' || incoming().branchId == getUserData().branchId);

      // Attachments are strictly immutable once uploaded
      allow update: if false;

      allow delete: if isSignedIn() && isValidId(attachmentId) && (
        isOrgManager(existing().orgId) ||
        existing().uploadedBy == request.auth.uid
      );
    }

    // Audit Logs Collection (Anti-Forgery & Completely Immutable)
    match /auditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isOrgManager(resource.data.orgId);
      allow list: if isSignedIn() && hasValidUserDoc() && isOrgManager(resource.data.orgId);

      allow create: if isSignedIn() && isValidId(logId) &&
        incoming().actorId == request.auth.uid &&
        incoming().actorName is string && incoming().actorName.size() >= 2 && incoming().actorName.size() <= 100 &&
        incoming().details is string && incoming().details.size() >= 5 && incoming().details.size() <= 1000 &&
        incoming().targetType in ['closing', 'branch', 'employee', 'organization'] &&
        incoming().targetId is string && isValidId(incoming().targetId) && (
          // Case 1: Initial Organization Establishment (Batch write by owner before user document existed)
          (
            incoming().action == 'ORGANIZATION_ESTABLISHED' &&
            incoming().actorRole == 'manager' &&
            incoming().targetType == 'organization' &&
            incoming().targetId == incoming().orgId &&
            !exists(/databases/$(database)/documents/organizations/$(incoming().targetId)) &&
            existsAfter(/databases/$(database)/documents/organizations/$(incoming().targetId)) &&
            getAfter(/databases/$(database)/documents/organizations/$(incoming().targetId)).data.ownerId == request.auth.uid &&
            existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == incoming().orgId &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'
          ) ||
          // Case 2: Established member operations (requires existing active user document before the operation)
          (
            hasValidUserDoc() &&
            isOrgMember(incoming().orgId) &&
            incoming().actorRole == getUserData().role &&
            incoming().orgId == getUserData().orgId && (
              // Employee can ONLY log legitimate shift submission or draft saving on closings,
              // with relational atomicity to the corresponding closing document
              (
                getUserData().role == 'employee' &&
                incoming().actorRole == 'employee' &&
                incoming().action in ['CLOSING_SUBMITTED_FOR_REVIEW', 'CLOSING_DRAFT_SAVED'] &&
                incoming().targetType == 'closing' &&
                getAfter(/databases/$(database)/documents/closings/$(incoming().targetId)).data.employeeId == request.auth.uid
              ) ||
              // Administrative actions strictly require active verified manager,
              // and are relationally tied to state transitions between get() and getAfter()
              (
                isOrgManager(incoming().orgId) &&
                incoming().actorRole == 'manager' && (
                  // 1. Approval: target closing MUST transition from 'pending_review' to 'approved' by this manager
                  (
                    incoming().action == 'CLOSING_APPROVED' &&
                    incoming().targetType == 'closing' &&
                    get(/databases/$(database)/documents/closings/$(incoming().targetId)).data.status == 'pending_review' &&
                    getAfter(/databases/$(database)/documents/closings/$(incoming().targetId)).data.status == 'approved' &&
                    getAfter(/databases/$(database)/documents/closings/$(incoming().targetId)).data.reviewedBy == request.auth.uid &&
                    getAfter(/databases/$(database)/documents/closings/$(incoming().targetId)).data.orgId == getUserData().orgId
                  ) ||
                  // 2. Rejection: target closing MUST transition from 'pending_review' to 'rejected' by this manager
                  (
                    incoming().action == 'CLOSING_REJECTED_FOR_REVISION' &&
                    incoming().targetType == 'closing' &&
                    get(/databases/$(database)/documents/closings/$(incoming().targetId)).data.status == 'pending_review' &&
                    getAfter(/databases/$(database)/documents/closings/$(incoming().targetId)).data.status == 'rejected' &&
                    getAfter(/databases/$(database)/documents/closings/$(incoming().targetId)).data.reviewedBy == request.auth.uid &&
                    getAfter(/databases/$(database)/documents/closings/$(incoming().targetId)).data.orgId == getUserData().orgId
                  ) ||
                  // 3. Branch Creation: target branch must NOT exist before, and MUST exist after and belong to org
                  (
                    incoming().action == 'BRANCH_CREATED' &&
                    incoming().targetType == 'branch' &&
                    !exists(/databases/$(database)/documents/branches/$(incoming().targetId)) &&
                    existsAfter(/databases/$(database)/documents/branches/$(incoming().targetId)) &&
                    getAfter(/databases/$(database)/documents/branches/$(incoming().targetId)).data.orgId == getUserData().orgId
                  ) ||
                  // 4. Employee Provisioning: target user must NOT exist before, and MUST exist after as employee in org
                  (
                    incoming().action == 'EMPLOYEE_PROVISIONED' &&
                    incoming().targetType == 'employee' &&
                    !exists(/databases/$(database)/documents/users/$(incoming().targetId)) &&
                    existsAfter(/databases/$(database)/documents/users/$(incoming().targetId)) &&
                    getAfter(/databases/$(database)/documents/users/$(incoming().targetId)).data.orgId == getUserData().orgId &&
                    getAfter(/databases/$(database)/documents/users/$(incoming().targetId)).data.role == 'employee'
                  ) ||
                  // 5. Employee Activation: target user MUST transition from isActive == false to isActive == true
                  (
                    incoming().action == 'EMPLOYEE_ACTIVATED' &&
                    incoming().targetType == 'employee' &&
                    get(/databases/$(database)/documents/users/$(incoming().targetId)).data.isActive == false &&
                    getAfter(/databases/$(database)/documents/users/$(incoming().targetId)).data.isActive == true &&
                    getAfter(/databases/$(database)/documents/users/$(incoming().targetId)).data.orgId == getUserData().orgId
                  ) ||
                  // 6. Employee Disabling: target user MUST transition from isActive == true to isActive == false
                  (
                    incoming().action == 'EMPLOYEE_DISABLED' &&
                    incoming().targetType == 'employee' &&
                    get(/databases/$(database)/documents/users/$(incoming().targetId)).data.isActive == true &&
                    getAfter(/databases/$(database)/documents/users/$(incoming().targetId)).data.isActive == false &&
                    getAfter(/databases/$(database)/documents/users/$(incoming().targetId)).data.orgId == getUserData().orgId
                  ) ||
                  // 7. Administrative Correction: target closing MUST be approved before and after, with actor verified as corrector
                  (
                    incoming().action == 'CLOSING_ADMIN_CORRECTED' &&
                    incoming().targetType == 'closing' &&
                    exists(/databases/$(database)/documents/closings/$(incoming().targetId)) &&
                    get(/databases/$(database)/documents/closings/$(incoming().targetId)).data.status == 'approved' &&
                    getAfter(/databases/$(database)/documents/closings/$(incoming().targetId)).data.status == 'approved' &&
                    getAfter(/databases/$(database)/documents/closings/$(incoming().targetId)).data.correctedBy == request.auth.uid &&
                    getAfter(/databases/$(database)/documents/closings/$(incoming().targetId)).data.orgId == getUserData().orgId &&
                    incoming().previousValues is map &&
                    incoming().newValues is map
                  )
                )
              )
            )
          )
        );

      // STRICT IMMUTABILITY: No one can ever edit or delete an audit log
      allow update, delete: if false;
    }

    // Closing Archives Index Collection
    match /closingArchives/{closingId} {
      allow get: if isSignedIn() && isValidId(closingId) &&
        hasValidUserDoc() &&
        canReadClosingArchive(resource.data);

      allow list: if isSignedIn() &&
        hasValidUserDoc() &&
        canReadClosingArchive(resource.data);

      allow create: if isSignedIn() && isValidId(closingId) &&
        incoming().keys().hasAll(['closingId', 'orgId', 'branchId', 'yearMonth', 'archiveStatus', 'updatedAt']) &&
        incoming().closingId == closingId &&
        isValidId(incoming().orgId) &&
        isValidId(incoming().branchId) &&
        isValidYearMonth(incoming().yearMonth) &&
        isValidIsoTimestamp(incoming().updatedAt) &&
        hasValidUserDoc() &&
        canCreateClosingArchive(closingId, incoming());

      allow update: if isSignedIn() && isValidId(closingId) &&
        incoming().keys().hasAll(['closingId', 'orgId', 'branchId', 'yearMonth', 'archiveStatus', 'updatedAt']) &&
        incoming().closingId == closingId &&
        incoming().closingId == existing().closingId &&
        incoming().orgId == existing().orgId &&
        incoming().branchId == existing().branchId &&
        incoming().yearMonth == existing().yearMonth &&
        isValidIsoTimestamp(incoming().updatedAt) &&
        hasValidUserDoc() &&
        canUpdateClosingArchive(closingId, incoming(), existing());

      allow delete: if false;
    }
  }
}
